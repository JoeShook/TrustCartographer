@page "/"
@inject IssuerKeyMaterial Keys
@inject CredentialCatalog Catalog
@inject IssuerProfile Profile

<PageTitle>IAL2 CSP Issuer</PageTitle>

<h1>Statewide IAL2 CSP Issuer</h1>
<p class="muted">
    OID4VCI 1.0 issuer for the <strong>Minor Identity Credential</strong> as an
    <code>vc+sd-jwt</code>. This issuer operates <strong>@Profile.PathwayLabel</strong>: rather
    than asserting a fixed level, it <strong>consults the Identity-CSP</strong> at issuance time and
    embeds the CSP-derived effective IDIAL (and the proofing-event id) into the credential.
</p>

<FluentCard Style="margin-bottom: 1rem;">
    <h3>Assurance pathway</h3>
    <table class="kv">
        <tbody>
            <tr><td>Pathway</td><td><code>@Profile.Pathway</code></td></tr>
            <tr><td>Source of assurance</td><td>Identity-CSP proofing event (delegated proofing)</td></tr>
            <tr><td>Assurance level</td><td><strong>derived per-offer</strong> (ceiling = delegate; floor IDIAL 2)</td></tr>
            <tr><td>Gate</td><td>Issuance is <strong>refused</strong> if the proofing event is not issuable.</td></tr>
        </tbody>
    </table>
    <p class="muted">
        Run a delegated proofing on the <a href="../identity-csp/proof" target="_blank">Identity-CSP</a> to get a
        proofing-event id, then mint here with that id. Compare with the <em>payer</em> (Pathway A) and
        <em>provider</em> (Pathway B) issuers, which assert a fixed assurance basis without a separate CSP.
    </p>
</FluentCard>

<FluentCard Style="margin-bottom: 1rem;">
    <h3>Issuer Identity</h3>
    <FluentLabel Typo="Typography.Body">DID</FluentLabel>
    <pre class="codeblock">@Keys.Did</pre>
    <FluentLabel Typo="Typography.Body">Verification Method</FluentLabel>
    <pre class="codeblock">@Keys.VerificationMethodId</pre>
</FluentCard>

<FluentCard>
    <h3>Supported credentials</h3>
    <ul>
        @foreach (var (id, cfg) in Catalog.SupportedConfigurations)
        {
            <li><strong>@id</strong> — format <code>@cfg.Format</code></li>
        }
    </ul>
    <p class="muted">
        Raw metadata:
        <a href=".well-known/openid-credential-issuer" target="_blank">/.well-known/openid-credential-issuer</a>.
    </p>
</FluentCard>

<style>
    .kv { font-size: 0.85rem; border-collapse: collapse; }
    .kv td { padding: 0.25rem 0.8rem 0.25rem 0; vertical-align: top; }
    .kv td:first-child { opacity: 0.7; white-space: nowrap; }
</style>
