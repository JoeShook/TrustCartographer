@{
    var prefix = HttpContext?.Request.PathBase.Value;
    var baseHref = string.IsNullOrEmpty(prefix) ? "/" : $"{prefix}/";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@baseHref" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TrustCartographer.HolderMinor.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/TrustCartographer.UI/TrustCartographer.UI.bundle.scp.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
}
