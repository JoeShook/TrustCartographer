@inherits LayoutComponentBase

<AppShell BrandText="TrustCartographer" BrandSublabel="Web">
    <NavLinks>
        <FluentNavLink Href="/" Match="NavLinkMatch.All"
                       Icon="@(new RegularIcons.Size20.Home())">
            Home
        </FluentNavLink>
        <FluentNavLink Href="/keys"
                       Icon="@(new RegularIcons.Size20.Key())">
            Key Pairs
        </FluentNavLink>
        <FluentNavGroup Title="Walkthroughs"
                        Icon="@(new RegularIcons.Size20.PlayCircle())">
            <FluentNavLink Href="/practitioner-license"
                           Icon="@(new RegularIcons.Size20.Certificate())">
                Practitioner License
            </FluentNavLink>
            <FluentNavGroup Title="Portable Identity Assurance"
                            Icon="@(new RegularIcons.Size20.Certificate())">
                <FluentNavLink Href="/pia"
                               Icon="@(new RegularIcons.Size20.PlayCircle())">
                    Overview
                </FluentNavLink>
                <FluentNavLink Href="/pia/minor-age-check"
                               Icon="@(new RegularIcons.Size20.Certificate())">
                    Minor Age Check
                </FluentNavLink>
            </FluentNavGroup>
        </FluentNavGroup>
        <FluentNavLink Href="/live-flow"
                       Icon="@(new RegularIcons.Size20.Pulse())">
            Live Flow
        </FluentNavLink>
        <FluentNavGroup Title="Comparisons"
                        Icon="@(new RegularIcons.Size20.ArrowSwap())">
            <FluentNavLink Href="/compare/client-auth"
                           Icon="@(new RegularIcons.Size20.LockClosed())">
                Client Auth: UDAP vs vLEI
            </FluentNavLink>
        </FluentNavGroup>
        <FluentNavGroup Title="Services"
                        Icon="@(new RegularIcons.Size20.Server())">
            <FluentNavLink Href="/identity-csp/" Icon="@(new RegularIcons.Size20.ShieldKeyhole())">Identity-CSP</FluentNavLink>
            <FluentNavLink Href="/payer-issuer/" Icon="@(new RegularIcons.Size20.Certificate())">Payer-Issuer (A)</FluentNavLink>
            <FluentNavLink Href="/provider-issuer/" Icon="@(new RegularIcons.Size20.Certificate())">Provider-Issuer (B)</FluentNavLink>
            <FluentNavLink Href="/csp-issuer/" Icon="@(new RegularIcons.Size20.Certificate())">CSP-Issuer (C)</FluentNavLink>
            <FluentNavLink Href="/issuer/" Icon="@(new RegularIcons.Size20.Certificate())">Issuer (triangle)</FluentNavLink>
            <FluentNavLink Href="/holder/" Icon="@(new RegularIcons.Size20.Wallet())">Guardian Wallet</FluentNavLink>
            <FluentNavLink Href="/holder-minor/" Icon="@(new RegularIcons.Size20.Wallet())">Minor's Wallet</FluentNavLink>
            <FluentNavLink Href="/verifier/" Icon="@(new RegularIcons.Size20.CheckmarkCircle())">Verifier</FluentNavLink>
        </FluentNavGroup>
    </NavLinks>
    <Body>
        @Body
    </Body>
</AppShell>
