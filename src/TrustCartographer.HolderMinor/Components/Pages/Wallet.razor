@page "/wallet"
@inject WalletStore Store
@inject TrustCartographer.Core.SdJwt.SdJwtService SdJwt

<PageTitle>Minor's Wallet — Credentials</PageTitle>

<h1>Held Credentials</h1>
<p class="muted">
    Credentials this (minor's) wallet holds in its own name. Expand a row to decode the
    credential; the <code>cnf</code> key binds it to this wallet, and the custody claims record
    the transfer from the guardian.
</p>

@if (Store.All().Count == 0)
{
    <FluentCard>
        <p class="muted"><em>No credentials yet. Custody-transfer one from the Guardian wallet.</em></p>
    </FluentCard>
}
else
{
    @foreach (var cred in Store.All().OrderByDescending(c => c.ReceivedAt))
    {
        var open = openIds.Contains(cred.Id);
        <FluentCard Style="margin-bottom: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;"
                 @onclick="() => Toggle(cred.Id)">
                <FluentIcon Value="@(open ? (Icon)new RegularIcons.Size20.ChevronDown() : new RegularIcons.Size20.ChevronRight())" />
                <div style="flex: 1;">
                    <strong>@cred.CredentialConfigurationId</strong>
                    <div class="muted" style="font-size: 0.9em;">
                        From @cred.CredentialIssuer · received @cred.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                    </div>
                </div>
            </div>
            @if (open)
            {
                <div style="margin-top: 0.75rem;">
                    <SdJwtViewer Credential="@SdJwt.Decode(cred.Jwt)" />
                </div>
            }
        </FluentCard>
    }
}

@code {
    private readonly HashSet<string> openIds = new();
    private void Toggle(string id)
    {
        if (!openIds.Add(id)) openIds.Remove(id);
    }
}
