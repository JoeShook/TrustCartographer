{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "issuer": {
        "ClusterId": "issuer",
        "Match": { "Path": "/issuer/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/issuer" } ]
      },
      "holder": {
        "ClusterId": "holder",
        "Match": { "Path": "/holder/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/holder" } ]
      },
      "verifier": {
        "ClusterId": "verifier",
        "Match": { "Path": "/verifier/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/verifier" } ]
      }
    },
    "Clusters": {
      "issuer": {
        "Destinations": { "primary": { "Address": "https://issuer" } }
      },
      "holder": {
        "Destinations": { "primary": { "Address": "https://holder" } }
      },
      "verifier": {
        "Destinations": { "primary": { "Address": "https://verifier" } }
      }
    }
  }
}
