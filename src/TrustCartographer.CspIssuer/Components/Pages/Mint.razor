@page "/mint"
@using System.Text.Json
@inject CredentialCatalog Catalog
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<PageTitle>Mint Credential Offer</PageTitle>

<h1>Mint a Credential Offer</h1>
<p class="muted">
    Pathway C: this issuer <strong>consults the Identity-CSP</strong> at offer time. Supply a
    proofing-event id (run one on the CSP, or use the helper below). The
    <code>/credential-offer</code> endpoint fetches that event, refuses if it is not issuable, and
    embeds the CSP-derived assurance into the credential.
</p>

<FluentCard Style="margin-bottom: 1rem;">
    <h3>1 · Delegated proofing event</h3>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom">
        <FluentTextField @bind-Value="proofingEventId" Label="Proofing event id" Style="min-width: 320px;" Placeholder="pe-…" />
        <FluentButton Appearance="Appearance.Neutral" OnClick="RunProofingAsync">
            @(isProofing ? "Running…" : "Run delegated proofing (login.gov-ial2)")
        </FluentButton>
    </FluentStack>
    <p class="muted" style="margin-top: 0.5rem;">
        Or run any method on the <a href="../identity-csp/proof" target="_blank">Identity-CSP Proof page</a> and paste its id.
    </p>
</FluentCard>

<FluentCard Style="margin-bottom: 1rem;">
    <h3>2 · Mint the offer</h3>
    <FluentSelect TOption="string"
                  Label="Credential type"
                  Items="@Catalog.SupportedConfigurations.Keys"
                  OptionValue="@(s => s)"
                  OptionText="@(s => s)"
                  @bind-Value="selectedConfigId" />

    <FluentStack Orientation="Orientation.Horizontal" Style="margin-top: 1rem;">
        <FluentButton Appearance="Appearance.Accent" OnClick="MintAsync">@(isMinting ? "Minting…" : "Mint offer")</FluentButton>
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@string.IsNullOrEmpty(offerUri)"
                      OnClick="SendToWalletAsync">
            @(isSending ? "Sending…" : "Send to Guardian wallet")
        </FluentButton>
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <span class="muted">@statusMessage</span>
        }
    </FluentStack>
</FluentCard>

@if (!string.IsNullOrEmpty(offerUri))
{
    <FluentCard Style="margin-bottom: 1rem;">
        <h3>Credential Offer URI</h3>
        <pre class="codeblock">@offerUri</pre>
    </FluentCard>
}

@code {
    private string selectedConfigId = CredentialCatalog.MinorIdentityId;
    private string proofingEventId = string.Empty;
    private string? offerUri;
    private string? statusMessage;
    private bool isProofing;
    private bool isMinting;
    private bool isSending;

    private async Task RunProofingAsync()
    {
        isProofing = true;
        statusMessage = null;
        try
        {
            var http = HttpFactory.CreateClient("loopback");
            http.BaseAddress = new Uri(ProxyRootFromBase(Nav.BaseUri));
            var resp = await http.PostAsJsonAsync("identity-csp/proofing-event", new { method = "login.gov-ial2" });
            resp.EnsureSuccessStatusCode();
            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("id", out var id))
                proofingEventId = id.GetString() ?? string.Empty;
            statusMessage = "Proofing event created on the CSP.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Proofing failed: {ex.Message}";
        }
        finally
        {
            isProofing = false;
        }
    }

    private async Task MintAsync()
    {
        isMinting = true;
        statusMessage = null;
        offerUri = null;
        try
        {
            var http = HttpFactory.CreateClient("loopback");
            http.BaseAddress = new Uri(Nav.BaseUri); // this app's proxied root, e.g. …/csp-issuer/
            var resp = await http.PostAsJsonAsync("credential-offer", new
            {
                credentialConfigurationId = selectedConfigId,
                proofingEventId = string.IsNullOrWhiteSpace(proofingEventId) ? null : proofingEventId
            });
            if (!resp.IsSuccessStatusCode)
            {
                statusMessage = $"Mint refused: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            var offer = await resp.Content.ReadFromJsonAsync<CreateOfferResponse>();
            offerUri = offer?.OfferUri;
            statusMessage = "Offer minted with CSP-derived assurance.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Mint failed: {ex.Message}";
        }
        finally
        {
            isMinting = false;
        }
    }

    private async Task SendToWalletAsync()
    {
        if (string.IsNullOrEmpty(offerUri)) return;
        isSending = true;
        statusMessage = null;
        try
        {
            var http = HttpFactory.CreateClient("loopback");
            http.BaseAddress = new Uri(ProxyRootFromBase(Nav.BaseUri));
            var resp = await http.PostAsJsonAsync("holder/wallet/redeem-offer", new { offerUri });
            resp.EnsureSuccessStatusCode();
            statusMessage = "Sent. See /live-flow on TC.Web for the captured trace.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Send failed: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private static string ProxyRootFromBase(string baseUri)
    {
        var uri = new Uri(baseUri);
        var trimmed = uri.AbsolutePath.TrimEnd('/');
        var slash = trimmed.LastIndexOf('/');
        var parent = slash > 0 ? trimmed[..slash] : "";
        return $"{uri.Scheme}://{uri.Authority}{parent}/";
    }
}
