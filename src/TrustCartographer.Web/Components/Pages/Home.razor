@page "/"

<PageTitle>TrustCartographer</PageTitle>

<h1>TrustCartographer</h1>

<p>An interactive explorer for trust models across decentralized identity, blockchain, and agent authentication.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Key Pairs</h5>
                <p class="card-text">Generate Ed25519 and secp256k1 key pairs. Explore signing, verification, and hashing.</p>
                <a href="keys" class="btn btn-primary">Explore</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">DIDs</h5>
                <p class="card-text">Create and resolve Decentralized Identifiers. Inspect DID Documents.</p>
                <button class="btn btn-outline-secondary" disabled>Coming Soon</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Verifiable Credentials</h5>
                <p class="card-text">Issue, hold, and verify credentials. Visualize the trust triangle.</p>
                <button class="btn btn-outline-secondary" disabled>Coming Soon</button>
            </div>
        </div>
    </div>
</div>
