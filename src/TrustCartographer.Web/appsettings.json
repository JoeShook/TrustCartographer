{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-csp": {
        "ClusterId": "identity-csp",
        "Match": { "Path": "/identity-csp/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/identity-csp" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/identity-csp" }
        ]
      },
      "issuer": {
        "ClusterId": "issuer",
        "Match": { "Path": "/issuer/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/issuer" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/issuer" }
        ]
      },
      "holder": {
        "ClusterId": "holder",
        "Match": { "Path": "/holder/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/holder" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/holder" }
        ]
      },
      "verifier": {
        "ClusterId": "verifier",
        "Match": { "Path": "/verifier/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/verifier" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/verifier" }
        ]
      }
    },
    "Clusters": {
      "identity-csp": {
        "Destinations": { "primary": { "Address": "https://identity-csp" } }
      },
      "issuer": {
        "Destinations": { "primary": { "Address": "https://issuer" } }
      },
      "holder": {
        "Destinations": { "primary": { "Address": "https://holder" } }
      },
      "verifier": {
        "Destinations": { "primary": { "Address": "https://verifier" } }
      }
    }
  }
}
