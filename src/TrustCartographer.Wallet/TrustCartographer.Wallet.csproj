<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wallet kit: OID4VCI redemption + OID4VP / SD-JWT presentation shared by every
       wallet app (guardian, minor). Pure backend; an SDK seed. FrameworkReference gives
       access to ASP.NET endpoint + logging types without being a web app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrustCartographer.Core\TrustCartographer.Core.csproj" />
  </ItemGroup>

</Project>
