@page "/keys"
@using TrustCartographer.Core.Models
@using TrustCartographer.Core.Services
@inject CryptoService Crypto
<PageTitle>Key Pair Explorer</PageTitle>

<FluentLabel Typo="Typography.H3" Style="margin-bottom: 4px;">Key Pair Explorer</FluentLabel>
<FluentLabel Typo="Typography.Body" Style="margin-bottom: 16px; opacity: 0.7;">Generate cryptographic key pairs and explore signing &amp; verification.</FluentLabel>

<FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-bottom: 24px;">
    <FluentButton Appearance="Appearance.Accent" OnClick="GenerateEd25519">Generate Ed25519</FluentButton>
    <FluentButton Appearance="Appearance.Outline" OnClick="GenerateSecp256k1">Generate secp256k1</FluentButton>
</FluentStack>

@if (_keyPair is not null)
{
    <FluentCard AreaRestricted="false" Style="padding: 20px; margin-bottom: 16px;">
        <FluentLabel Typo="Typography.H5" Style="margin-bottom: 12px;">@_keyPair.Algorithm Key Pair</FluentLabel>

        <FluentLabel Typo="Typography.H6">Private Key</FluentLabel>
        <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Hex (@(_keyPair.PrivateKey.Length) bytes)</FluentLabel>
        <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; margin-bottom: 8px; background: var(--neutral-layer-4);">@_keyPair.PrivateKeyHex</code>
        <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Base64url</FluentLabel>
        <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; margin-bottom: 16px; background: var(--neutral-layer-4);">@_keyPair.PrivateKeyBase64Url</code>

        <FluentLabel Typo="Typography.H6">Public Key</FluentLabel>
        <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Hex (@(_keyPair.PublicKey.Length) bytes)</FluentLabel>
        <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; margin-bottom: 8px; background: var(--neutral-layer-4);">@_keyPair.PublicKeyHex</code>
        <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Base64url</FluentLabel>
        <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; background: var(--neutral-layer-4);">@_keyPair.PublicKeyBase64Url</code>
    </FluentCard>

    @if (_keyPair.Algorithm == "Ed25519")
    {
        <FluentCard AreaRestricted="false" Style="padding: 20px; margin-bottom: 16px;">
            <FluentLabel Typo="Typography.H5" Style="margin-bottom: 12px;">Sign &amp; Verify</FluentLabel>

            <FluentTextField @bind-Value="_message" Placeholder="Enter a message to sign..." Label="Message" Style="width: 100%; margin-bottom: 12px;" />

            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-bottom: 16px;">
                <FluentButton Appearance="Appearance.Outline" OnClick="Sign">Sign</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="Verify" Disabled="@(_signatureResult is null)">Verify</FluentButton>
            </FluentStack>

            @if (_signatureResult is not null)
            {
                <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Signature (Hex)</FluentLabel>
                <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; margin-bottom: 8px; background: var(--neutral-layer-4);">@_signatureResult.SignatureHex</code>
                <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">Signature (Base64url)</FluentLabel>
                <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; margin-bottom: 8px; background: var(--neutral-layer-4);">@_signatureResult.SignatureBase64Url</code>
            }

            @if (_verificationResult is not null)
            {
                <FluentMessageBar Intent="@(_verificationResult.Value ? MessageIntent.Success : MessageIntent.Error)" Style="margin-top: 8px;">
                    Signature is <strong>@(_verificationResult.Value ? "VALID" : "INVALID")</strong>
                </FluentMessageBar>
            }
        </FluentCard>
    }

    <FluentCard AreaRestricted="false" Style="padding: 20px; margin-bottom: 16px;">
        <FluentLabel Typo="Typography.H5" Style="margin-bottom: 12px;">SHA-256 Hash</FluentLabel>

        <FluentTextField @bind-Value="_hashInput" Placeholder="Enter text to hash..." Label="Input" Style="width: 100%; margin-bottom: 12px;" />

        <FluentButton Appearance="Appearance.Outline" OnClick="ComputeHash">Hash</FluentButton>

        @if (_hashOutput is not null)
        {
            <div style="margin-top: 12px;">
                <FluentLabel Style="opacity: 0.6; font-size: 0.85rem;">SHA-256 (Hex)</FluentLabel>
                <code style="display: block; word-break: break-all; padding: 8px; border-radius: 4px; background: var(--neutral-layer-4);">@Convert.ToHexString(_hashOutput).ToLowerInvariant()</code>
            </div>
        }
    </FluentCard>
}

@code {
    private KeyPairInfo? _keyPair;
    private string _message = string.Empty;
    private SignatureResult? _signatureResult;
    private bool? _verificationResult;
    private string _hashInput = string.Empty;
    private byte[]? _hashOutput;

    private void GenerateEd25519()
    {
        _keyPair = Crypto.GenerateEd25519KeyPair();
        ResetSignature();
    }

    private void GenerateSecp256k1()
    {
        _keyPair = Crypto.GenerateSecp256k1KeyPair();
        ResetSignature();
    }

    private void Sign()
    {
        if (_keyPair is null || string.IsNullOrEmpty(_message)) return;
        _signatureResult = Crypto.SignEd25519(_keyPair.PrivateKey, _message);
        _verificationResult = null;
    }

    private void Verify()
    {
        if (_keyPair is null || _signatureResult is null) return;
        _verificationResult = Crypto.VerifyEd25519(_keyPair.PublicKey, _message, _signatureResult.Signature);
    }

    private void ComputeHash()
    {
        if (string.IsNullOrEmpty(_hashInput)) return;
        _hashOutput = Crypto.ComputeSha256(_hashInput);
    }

    private void ResetSignature()
    {
        _signatureResult = null;
        _verificationResult = null;
    }
}
