@page "/request"
@using System.Net.Http.Json
@using System.Text.Json
@using TrustCartographer.Core.Oid4Vp
@inject VerifierStores Stores
@inject PresentationCatalog Catalog
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<PageTitle>Request a Presentation</PageTitle>

<h1>Request a Presentation</h1>
<p class="muted">
    Mints an OID4VP authorization request (a one-time <code>state</code> + <code>nonce</code>,
    delivered by reference so the wallet dereferences it) and shows the request object.
    Hand the URI to a wallet to receive and verify a presentation.
</p>

<FluentCard Style="margin-bottom: 1rem;">
    <h3>Presentation definition</h3>
    <p class="muted">
        Requires <code>@PresentationCatalog.RequiredCredentialType</code> —
        @Catalog.Purpose
    </p>
    <FluentStack Orientation="Orientation.Horizontal" Style="margin-top: 1rem;">
        <FluentButton Appearance="Appearance.Accent" OnClick="CreateRequest">Create request</FluentButton>
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@string.IsNullOrEmpty(requestUri)"
                      OnClick="SendToWalletAsync">
            @(isSending ? "Sending…" : "Send to local Holder wallet")
        </FluentButton>
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <span class="muted">@statusMessage</span>
        }
    </FluentStack>
</FluentCard>

@if (!string.IsNullOrEmpty(requestUri))
{
    <FluentCard Style="margin-bottom: 1rem;">
        <h3>Authorization Request URI</h3>
        <pre class="codeblock">@requestUri</pre>
    </FluentCard>

    <FluentCard>
        <h3>Authorization Request</h3>
        <pre class="codeblock">@requestJson</pre>
    </FluentCard>
}

@code {
    private string? requestUri;
    private string? requestJson;
    private string? statusMessage;
    private bool isSending;

    private void CreateRequest()
    {
        statusMessage = null;
        var definition = new PresentationDefinition
        {
            Id = $"pd-{Guid.NewGuid():N}",
            RequiredCredentialType = PresentationCatalog.RequiredCredentialType,
            Purpose = Catalog.Purpose
        };
        var pending = Stores.CreateRequest(definition, TimeSpan.FromMinutes(5));

        var clientId = TrimTrailingSlash(Nav.BaseUri);
        var request = new PresentationRequest
        {
            ClientId = clientId,
            Nonce = pending.Nonce,
            ResponseUri = $"{clientId}/presentation-response",
            State = pending.State,
            PresentationDefinition = definition
        };

        requestUri = PresentationRequestUri.BuildByReference($"{clientId}/presentation-request/{pending.State}");
        requestJson = JsonSerializer.Serialize(request, new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task SendToWalletAsync()
    {
        if (string.IsNullOrEmpty(requestUri)) return;
        isSending = true;
        statusMessage = null;
        try
        {
            var http = HttpFactory.CreateClient("loopback");
            http.BaseAddress = new Uri(ProxyRootFromBase(Nav.BaseUri));
            var resp = await http.PostAsJsonAsync("holder/wallet/present", new { requestUri });
            resp.EnsureSuccessStatusCode();
            var result = await resp.Content.ReadFromJsonAsync<JsonElement>();
            var status = result.TryGetProperty("status", out var s) ? s.GetString() : "?";
            statusMessage = $"Wallet presented — verdict: {status}. See /live-flow and the Activity page.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Send failed: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private static string TrimTrailingSlash(string s) => s.EndsWith('/') ? s[..^1] : s;

    private static string ProxyRootFromBase(string baseUri)
    {
        // Nav.BaseUri is the public path the Verifier is mounted at, e.g.
        // "https://localhost:7257/verifier/". Strip the last segment to point at
        // the proxy root so we can address /holder/* alongside.
        var uri = new Uri(baseUri);
        var trimmed = uri.AbsolutePath.TrimEnd('/');
        var slash = trimmed.LastIndexOf('/');
        var parent = slash > 0 ? trimmed[..slash] : "";
        return $"{uri.Scheme}://{uri.Authority}{parent}/";
    }
}
